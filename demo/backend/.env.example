# Backend listen address
DEMO_API_HOST=0.0.0.0
DEMO_API_PORT=8000

# Comma-separated origins allowed for CORS (frontend dev servers).
# Tighten in production, e.g. DEMO_CORS_ORIGINS=https://demo.example.org
DEMO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Read-only root for experiment outputs (defaults to <repo>/outputs)
# DEMO_OUTPUTS_ROOT=/path/to/wild-palm-lvm-verification/outputs
